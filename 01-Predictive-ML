    {
      "cell_type": "code",
      "source": [
        "# The imbalance is about a 67%-33% split, that is not too bad. Now, let's create an oversampled version of our training dataset, then an undersampled version:\n",
        "\n",
        "os = SMOTE (sampling_strategy = 1, k_neighbors = 5, random_state = 1)\n",
        "\n",
        "x_train_os, y_train_os = os.fit_resample (x_train, y_train)\n",
        "\n",
        "print (\"Class proportions after oversampling: \", y_train_os.value_counts(1), \"\\n\")\n",
        "print (\"Class counts after oversampling: \", y_train_os.value_counts(), \"\\n\")\n",
        "print (\"Dataset size after oversampling: \", y_train_os.shape, \"\\n\\n\")\n",
        "\n",
        "us = RandomUnderSampler (sampling_strategy = 1, random_state = 1)\n",
        "\n",
        "x_train_us, y_train_us = us.fit_resample (x_train, y_train)\n",
        "\n",
        "print (\"Class proportions after undersampling: \", y_train_us.value_counts(1), \"\\n\")\n",
        "print (\"Class counts after undersampling: \", y_train_us.value_counts(), \"\\n\")\n",
        "print (\"Dataset size after undersampling: \", y_train_us.shape, \"\\n\\n\")\n",
        "\n",
        "# Let's compare the resampled training datasets against the original training dataset:\n",
        "\n",
        "print (\"Class proportions of original training dataset: \", y_train.value_counts(1), \"\\n\")\n",
        "print (\"Class counts of original training dataset: \", y_train.value_counts(), \"\\n\")\n",
        "print (\"Dataset size of original training dataset: \", y_train.shape)"
      ],
